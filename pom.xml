<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.cristian</groupId>
  <artifactId>ftopforge</artifactId>
  <version>1.2.5</version>
  <packaging>jar</packaging>

  <name>FTopForge</name>
  <description>Factions ranking with bells and whistles (internal Tiamat custom)</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
  </properties>

  <repositories>
    <repository>
      <id>spigotmc-repo</id>
      <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
    </repository>
    <repository>
      <id>sonatype</id>
      <url>https://oss.sonatype.org/content/groups/public/</url>
    </repository>
    <repository>
      <id>jitpack</id>
      <url>https://jitpack.io</url>
    </repository>
    <repository>
      <id>placeholderapi</id>
      <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Spigot 1.8.8 API (compile-only; runtime is provided by the server) -->
    <dependency>
      <groupId>org.spigotmc</groupId>
      <artifactId>spigot-api</artifactId>
      <version>1.8.8-R0.1-SNAPSHOT</version>
      <scope>provided</scope>
      <!-- 21/9/2026: Spigot dejo de servir bungeecord-chat:1.8-SNAPSHOT y sin esto el repo
           ya no compila. El codigo no usa ni una clase de net.md_5, y la dependencia es
           provided (la pone el servidor), asi que excluirla no cambia el jar. -->
      <exclusions>
        <exclusion>
          <groupId>net.md-5</groupId>
          <artifactId>bungeecord-chat</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- FactionsUUID 1.6.9.5-U0.6.32 (confirmed by Task 1 against installed jar) via JitPack.
         JitPack uses just the U-version "0.6.32" as the tag/version string, not the full
         "1.6.9.5-U0.6.32" plugin.yml version. Confirmed via https://jitpack.io/api/builds/com.github.drtshock/Factions -->
    <dependency>
      <groupId>com.github.drtshock</groupId>
      <artifactId>Factions</artifactId>
      <version>0.6.32</version>
      <scope>provided</scope>
    </dependency>

    <!-- Vault API (hard-dep, compile-only) -->
    <dependency>
      <groupId>com.github.MilkBowl</groupId>
      <artifactId>VaultAPI</artifactId>
      <version>1.7</version>
      <scope>provided</scope>
    </dependency>

    <!-- PAPI (soft-dep, compile-only) -->
    <dependency>
      <groupId>me.clip</groupId>
      <artifactId>placeholderapi</artifactId>
      <version>2.11.6</version>
      <scope>provided</scope>
    </dependency>

    <!-- DecentHolograms (soft-dep, compile-only) via JitPack.
         NOTE: HolographicDisplays support was dropped in 1.2.0-RC1 because the
         HD artifact does not resolve from JitPack (filoghost-dev returns 401
         for v-prefixed tags, and the un-prefixed tag has no published jar).
         FACTIONS production uses DH 2.8.4 â€” DH is the only engine in practice. -->
    <dependency>
      <groupId>com.github.DecentSoftware-eu</groupId>
      <artifactId>DecentHolograms</artifactId>
      <version>2.8.4</version>
      <scope>provided</scope>
    </dependency>

    <!-- HikariCP 4.0.3 (last Java 8 compatible version) - shaded -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>4.0.3</version>
    </dependency>

    <!-- SLF4J (HikariCP runtime dep) - shaded -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <version>1.7.36</version>
    </dependency>

    <!-- sqlite-jdbc 3.42.0.0 (last Java 8 compatible) - shaded -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.42.0.0</version>
    </dependency>

    <!-- bStats (shaded + relocated) -->
    <dependency>
      <groupId>org.bstats</groupId>
      <artifactId>bstats-bukkit</artifactId>
      <version>3.0.2</version>
      <scope>compile</scope>
    </dependency>

    <!-- JUnit for pure-logic tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>

    <!-- Mockito 5 for DAO mocking in SkullCacheTest (requires Java 11+ at test runtime; JDK 21 OK) -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.11.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>ftopforge-${project.version}</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>plugin.yml</include>
          <include>banner.txt</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>plugin.yml</exclude>
          <exclude>banner.txt</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <minimizeJar>false</minimizeJar>
              <relocations>
                <relocation>
                  <pattern>com.zaxxer.hikari</pattern>
                  <shadedPattern>com.cristian.ftopforge.libs.hikari</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.slf4j</pattern>
                  <shadedPattern>com.cristian.ftopforge.libs.slf4j</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.bstats</pattern>
                  <shadedPattern>com.cristian.ftopforge.libs.bstats</shadedPattern>
                </relocation>
                <!-- DO NOT relocate org.sqlite - native libs hardcode the package -->
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/maven/**</exclude>
                    <!-- Binarios de SQLite para plataformas en las que no corre un
                         servidor de Paper. Eran 24 MB de los 20 del jar. Se
                         conservan Linux/Windows x86_64 y aarch64, y los dos Mac
                         para quien desarrolla en uno. -->
                    <exclude>org/sqlite/native/Linux-Android/**</exclude>
                    <exclude>org/sqlite/native/Linux-Musl/**</exclude>
                    <exclude>org/sqlite/native/FreeBSD/**</exclude>
                    <exclude>org/sqlite/native/Linux/arm/**</exclude>
                    <exclude>org/sqlite/native/Linux/armv6/**</exclude>
                    <exclude>org/sqlite/native/Linux/armv7/**</exclude>
                    <exclude>org/sqlite/native/Linux/x86/**</exclude>
                    <exclude>org/sqlite/native/Linux/ppc64/**</exclude>
                    <exclude>org/sqlite/native/Linux/riscv64/**</exclude>
                    <exclude>org/sqlite/native/Windows/x86/**</exclude>
                    <exclude>org/sqlite/native/Windows/armv7/**</exclude>
                    <exclude>META-INF/services/java.sql.Driver</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
